# Edit this file to introduce tasks to be run by cron.
# 
# Each task to run has to be defined through a single line
# indicating with different fields when the task will be run
# and what command to run for the task
# 
# To define the time you can provide concrete values for
# minute (m), hour (h), day of month (dom), month (mon),
# and day of week (dow) or use '*' in these fields (for 'any').
# 
# Notice that tasks will be started based on the cron's system
# daemon's notion of time and timezones.
# 
# Output of the crontab jobs (including errors) is sent through
# email to the user the crontab file belongs to (unless redirected).
# 
# For example, you can run a backup of all your user accounts
# at 5 a.m every week with:
# 0 5 * * 1 tar -zcf /var/backups/home.tgz /home/
# 
# For more information see the manual pages of crontab(5) and cron(8)
# 
# m h  dom mon dow   command
# Generate landing pages
#30 * * * * BASH_ENV=/home/ubuntu/spase-generate-pages/path.txt bash -l -c "cd /home/ubuntu/spase-generate-pages; bash update-pages.sh" && bash -l -c "cd /home/ubuntu/spase-generate-pages; bash push-pages.sh"
# Refresh the landing pages at the bottom of every hour 
30 * * * * BASH_ENV=/home/ubuntu/spase-generate-pages/path.txt bash -l -c "cd /home/ubuntu/spase-generate-pages; bash update-pages.sh; cp -r metadata.src/NASA /home/ubuntu; cp -r metadata.src/SMWG /home/ubuntu" && bash -l -c "cd /home/ubuntu/spase-generate-pages; venv/bin/python fixSchema_Org_Metadata.py /home/ubuntu/tmp/schemaOrg_Overrides.txt >> /home/ubuntu/tmp/cronjob.log 2>&1; bash push-pages.sh"
# Every Sunday refresh the whole thing to delete old file names (2025/04/08 moving to prune_pages.php for this operation - do not reinstate)
#5  0 * * 0 BASH_ENV=/home/ubuntu/spase-generate-pages/path.txt /usr/bin/php /home/ubuntu/spase-generate-pages/clear_pagesDO_NOT_RUN.php
10 0 * * Sun BASH_ENV=/home/ubuntu/spase-generate-pages/path.txt bash -l -c "cd /home/ubuntu/spase-generate-pages; bash generate-all-pages.sh; cp -r metadata.src/NASA /home/ubuntu; cp -r metadata.src/SMWG /home/ubuntu" && bash -l -c "cd /home/ubuntu/spase-generate-pages; bash push-pages.sh"
# Clean out landing pages for deleted and renamed descriptor files
55 * * * * BASH_ENV=/home/ubuntu/spase-generate-pages/path.txt bash -l -c "cd /home/ubuntu/spase-generate-pages; /usr/bin/php /home/ubuntu/spase-generate-pages/prune_pages.php >> /tmp/prune.out" && bash -l -c "cd /home/ubuntu/spase-generate-pages; cp -r metadata.src/NASA /home/ubuntu; cp -r metadata.src/SMWG /home/ubuntu; bash push-pages.sh"
20 * * * * curl https://spase-metadata.org/naming_auths.json > /home/ubuntu/spase-generate-pages/naming_auths.json
# Perform schema validation
#0 2 * * 6 BASH_ENV=/etc/profile bash -l -c "bash validate.sh"
0 2 * * Sat BASH_ENV=/home/ubuntu/spase-generate-pages/path.txt bash -l -c "bash validate.sh"
# Perform ID referential check
0 3 * * Sat BASH_ENV=/home/ubuntu/spase-generate-pages/path.txt bash -l -c "bash refcheck-id.sh"
# Perform URL referential check
0 4 * * Sat BASH_ENV=/home/ubuntu/spase-generate-pages/path.txt bash -l -c "bash refcheck-url.sh"
# Perform full github naming authority pull including cloning of new repositories
5 0 * * * BASH_ENV=/home/ubuntu/spase-generate-pages/path.txt /usr/bin/php /home/ubuntu/spase-generate-pages/clone_new.php
#
#
# SPASE Backups (to s3 bucket)
#
# backup SPASE records at daily cadence (Runs at 12:00 AM every day)
@daily BASH_ENV=/home/ubuntu/spase-generate-pages/path.txt bash -l -c "cd /home/ubuntu/spase-scripts; bash zip-spase.sh" && bash -l -c "cd /home/ubuntu/spase-generate-pages; aws s3 mv s3://spase-backups/Daily/SPASE_$(date -d 'yesterday' +"\%Y-\%m-\%d").zip $(bash /home/ubuntu/spase-scripts/s3PathGen.sh s3://spase-backups/Daily/SPASE_$(date -d 'yesterday' +"\%Y-\%m-\%d").zip); aws s3 mv ./SPASE_$(date +"\%Y-\%m-\%d").zip s3://spase-backups/Daily/"
# backup SPASE records weekly (every Sunday at 12:20 AM)
20 0 * * Sun BASH_ENV=/home/ubuntu/spase-generate-pages/path.txt bash -l -c "cd /home/ubuntu/spase-scripts; bash zip-spase.sh" && bash -l -c "cd /home/ubuntu/spase-generate-pages; aws s3 rm s3://spase-backups/Weekly/ --recursive; aws s3 mv ./SPASE_$(date +"\%Y-\%m-\%d").zip s3://spase-backups/Weekly/"
# backup SPASE records ~bi-weekly (first and 15th day every month at 12:30 AM)
30 0 1,15 * * BASH_ENV=/home/ubuntu/spase-generate-pages/path.txt bash -l -c "cd /home/ubuntu/spase-scripts; bash zip-spase.sh" && bash -l -c "cd /home/ubuntu/spase-generate-pages; aws s3 rm s3://spase-backups/Bi-Weekly/ --recursive; aws s3 mv ./SPASE_$(date +"\%Y-\%m-\%d").zip s3://spase-backups/Bi-Weekly/"
# backup SPASE records monthly (every 1st day of month at 12:40 AM)
40 0 1 * * BASH_ENV=/home/ubuntu/spase-generate-pages/path.txt bash -l -c "cd /home/ubuntu/spase-scripts; bash zip-spase.sh" && bash -l -c "cd /home/ubuntu/spase-generate-pages; aws s3 rm s3://spase-backups/Monthly/ --recursive; aws s3 mv ./SPASE_$(date +"\%Y-\%m-\%d").zip s3://spase-backups/Monthly/"
# backup SPASE records quarterly (first day every three months at 12:50 AM)
50 0 1 */3 * BASH_ENV=/home/ubuntu/spase-generate-pages/path.txt bash -l -c "cd /home/ubuntu/spase-scripts; bash zip-spase.sh" && bash -l -c "cd /home/ubuntu/spase-generate-pages; aws s3 rm s3://spase-backups/Quarterly/ --recursive; aws s3 mv ./SPASE_$(date +"\%Y-\%m-\%d").zip s3://spase-backups/Quarterly/"
# backup SPASE records annually (every first day of year at 1 AM)
0 1 1 1 * BASH_ENV=/home/ubuntu/spase-generate-pages/path.txt bash -l -c "cd /home/ubuntu/spase-scripts; bash zip-spase.sh" && bash -l -c "cd /home/ubuntu/spase-generate-pages; aws s3 mv ./SPASE_$(date +"\%Y-\%m-\%d").zip s3://spase-backups/Yearly/"
